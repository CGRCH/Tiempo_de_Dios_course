# Tiempo de Dios Cursos — variables de entorno (copiar a .env)

POSTGRES_DB=tiempodedios
POSTGRES_USER=tiempodedios
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

MEDIA_ROOT=/app/media
VIDEO_SIGNING_SECRET=change-me-video-signing-secret
VIDEO_URL_TTL_SECONDS=3600

# Security / demo payments
ALLOW_SIMULATED_PAYMENTS=1
JWT_ACCESS_COOKIE_NAME=td_access
JWT_REFRESH_COOKIE_NAME=td_refresh
JWT_COOKIE_SECURE=0
JWT_COOKIE_SAMESITE=Lax

NEXT_PUBLIC_API_URL=http://localhost:8000/api
INTERNAL_API_URL=http://backend:8000/api

CELERY_TASK_ALWAYS_EAGER=0
